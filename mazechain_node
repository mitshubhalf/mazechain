#!/bin/bash
# MazeChain Node — inicia o nó completo com API REST e mineração automática
# Uso: ./mazechain_node
# O nó ficará disponível em http://localhost:10000

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
mkdir -p "$SCRIPT_DIR/data"
export PORT=10000
exec "$SCRIPT_DIR/mazechain_api"
